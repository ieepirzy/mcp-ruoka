# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# OAuth client credentials (for claude.ai and other MCP clients)
# If this server sits behind Origo, prefer authenticating at Origo and use MCP_AUTH_TOKEN
# only for the Origo -> mcp-ruoka service boundary.
# Generate with: openssl rand -hex 32
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
PORT=3001

# Optional personal default for K-Ruoka product search.
# Prefer the stable store ID when known. Otherwise the query is resolved lazily once
# against K-Ruoka store search and cached for the process lifetime.
DEFAULT_K_RUOKA_STORE_ID=
DEFAULT_K_RUOKA_STORE_QUERY=
